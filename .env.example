# Copy this file to .env and fill in real values.
# Get these from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — the bare-root URL registered as the claude.ai Custom Connector.
# Falls back to window.location.origin if unset (correct for the default setup).
VITE_MCP_PUBLIC_URL=https://crm.peterpaullazan.com

# Optional — enables Settings → API Integration → Connect Gmail (real Inbox sync).
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# This is the public client ID, safe client-side (the client secret stays server-side only,
# as GOOGLE_CLIENT_SECRET in Supabase Edge Function secrets). See
# EMAIL_INBOX_SENT_DRAFTS_BACKEND_IMPLEMENTATION.md Phase 3a for full setup steps.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
